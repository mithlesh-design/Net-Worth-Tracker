# ═══════════════════════════════════════════════════════════
# Networth Planner — Environment Variables
# ═══════════════════════════════════════════════════════════
# Copy this file to .env.local and fill in the values.
# The app works WITHOUT auth — these are only needed for
# login and profile save/load features.

# ── How sign-in switches on ───────────────────────────────
# Nothing to flip: sign-in turns itself on when the values it needs
# are here (lib/authStatus.mjs). Until then there is no Log in button,
# See Results is not gated, and /auth/* redirects to the planner.
#   Google      NEXTAUTH_SECRET + GOOGLE_CLIENT_ID + GOOGLE_CLIENT_SECRET
#   Email link  NEXTAUTH_SECRET + EMAIL_SERVER_HOST + EMAIL_FROM + Supabase
# Step by step: docs/AUTH-SETUP.md

# ── NextAuth ──────────────────────────────────────────────
# Generate with: openssl rand -base64 32
# Credentials are left blank on purpose: a placeholder here would count as
# configured and switch on a sign-in that cannot work.
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# ── Google OAuth ──────────────────────────────────────────
# Get from: https://console.cloud.google.com/apis/credentials
# Create OAuth 2.0 Client ID → Web application
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Email (Magic Link) ───────────────────────────────────
# Any SMTP provider works (Gmail, Resend, SendGrid, etc.)
# For Resend: host=smtp.resend.com, port=465, user=resend, pass=your API key,
# from=an address on a domain verified in Resend (e.g. plans@yourdomain.com)
EMAIL_SERVER_HOST=
EMAIL_SERVER_PORT=465
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=
EMAIL_FROM=

# ── Supabase ──────────────────────────────────────────────
# Get from: https://supabase.com/dashboard → Settings → API
# e.g. https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── TEMPORARY: preview-only demo login ────────────────────
# Makes the sign-in page mint a fake browser-only session instead of
# signing in for real, so the logged-in flow can be previewed before
# the credentials above exist. Demo profiles stay in this browser's
# local storage and never reach Supabase.
#   NEXT_PUBLIC_DEMO_AUTH=true       development only (production
#                                    builds ignore it)
#   NEXT_PUBLIC_DEMO_AUTH_LIVE=true  also on the live site, set by
#                                    .env.production, until a real
#                                    sign-in method replaces it
# Anything but "true" is off.
NEXT_PUBLIC_DEMO_AUTH=false
